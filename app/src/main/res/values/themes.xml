<resources>
    <style name="Theme.SimpleKeyboard" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:navigationBarColor">@color/screen_background</item>
    </style>

    <style name="Theme.SimpleKeyboard.Light" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:navigationBarColor">@color/screen_background</item>
    </style>

    <style name="Theme.SimpleKeyboard.Accent" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#892929</item>
        <item name="colorPrimaryVariant">#681D1D</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorSecondary">#892929</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#FFF8F7</item>
        <item name="android:statusBarColor">#681D1D</item>
        <item name="android:navigationBarColor">#FFF8F7</item>
    </style>

    <style name="Theme.SimpleKeyboard.Dark" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#B96C6C</item>
        <item name="colorPrimaryVariant">#892929</item>
        <item name="colorOnPrimary">#1D1515</item>
        <item name="colorSecondary">#B96C6C</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#1D1515</item>
        <item name="android:statusBarColor">#1D1515</item>
        <item name="android:navigationBarColor">#1D1515</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Widget.SimpleKeyboard.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="Widget.SimpleKeyboard.SecondaryButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary_dark</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="Widget.SimpleKeyboard.TextButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/primary_dark</item>
    </style>

    <style name="Widget.SimpleKeyboard.ThemeButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary_dark</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">none</item>
        <item name="android:paddingStart">1dp</item>
        <item name="android:paddingEnd">1dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
    </style>
</resources>
